{
    "name": "event-planner",
    "version": "1.0.0",
    "description": "Event Planner built for KeukentafelMTG",
    "license": "ISC",
    "author": "Duxez",
    "type": "module",
    "main": "src/index.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "build": "tsc -p .",
        "start": "tsc -p . && node --env-file=.env ./dist/index.js",
        "deploy": "node --env-file=.env ./dist/deploy.js",
        "lint": "eslint .",
        "migration:create": "mikro-orm migration:create --config=./src/mikro-orm.config.ts",
        "migration:up": "mikro-orm migration:up --config=./src/mikro-orm.config.ts",
        "migration:down": "mikro-orm migration:down --config=./src/mikro-orm.config.ts",
        "migration:list": "mikro-orm migration:list --config=./src/mikro-orm.config.ts",
        "migration:pending": "mikro-orm migration:pending --config=./src/mikro-orm.config.ts",
        "migration:fresh": "mikro-orm migration:fresh --config=./src/mikro-orm.config.ts",
        "schema:drop": "mikro-orm schema:drop --config=./src/mikro-orm.config.ts",
        "schema:create": "mikro-orm schema:create --config=./src/mikro-orm.config.ts",
        "schema:update": "mikro-orm schema:update --config=./src/mikro-orm.config.ts"
    },
    "devDependencies": {
        "@mikro-orm/cli": "^6.6.3",
        "@mikro-orm/core": "^6.6.3",
        "@mikro-orm/sqlite": "^6.6.3",
        "@types/express": "^4.17.25",
        "@types/node": "^20.19.27",
        "eslint": "^9.39.1",
        "prettier": "^3.6.2",
        "ts-node": "^10.9.2",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@mikro-orm/mariadb": "^6.6.3",
        "@mikro-orm/migrations": "^6.6.3",
        "@mikro-orm/reflection": "^6.6.3",
        "discord.js": "^14.25.0",
        "dotenv": "^17.2.3",
        "uuid": "^13.0.0",
        "zod": "^4.3.5"
    },
    "mikro-orm": {
        "configPaths": [
            "src/mikro-orm.config.ts"
        ],
        "useTsNode": true
    }
}
